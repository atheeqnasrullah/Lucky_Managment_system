# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

# Backends — defaults run fully offline/in-memory.
#   STORAGE_BACKEND: memory | gcp        (gcp = Firestore + Cloud Storage)
#   VECTOR_BACKEND:  memory | pinecone
#   TASK_BACKEND:    inline | cloudtasks
#   AI_BACKEND:      fake   | openai
#   WHATSAPP_BACKEND: fake  | cloud
STORAGE_BACKEND=memory
VECTOR_BACKEND=memory
TASK_BACKEND=inline
AI_BACKEND=fake
WHATSAPP_BACKEND=fake

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Pinecone (serverless index, dimension = EMBEDDING_DIMENSION, metric = cosine)
PINECONE_API_KEY=
PINECONE_INDEX=invoices

# Google Cloud
GCP_PROJECT=
GCS_BUCKET=
TASKS_QUEUE=invoice-jobs
TASKS_LOCATION=us-central1
TASKS_SERVICE_ACCOUNT=
TASKS_AUDIENCE=

# Behaviour
MAX_UPLOAD_MB=20
CONFIDENCE_THRESHOLD=0.8
RATE_LIMIT_PER_MINUTE=20
AUTO_PROVISION_TENANTS=true

# Local only (ENVIRONMENT=local + STORAGE_BACKEND=memory): demo API key seeded at startup
# for the /docs "Authorize" button. Ignored in every other environment.
DEV_API_KEY=dev-key-123
